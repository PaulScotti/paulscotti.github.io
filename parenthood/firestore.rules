rules_version = '2';

// Template: setup.mjs fills in the list of the two allowed Google accounts (kept out of the public repo)
// and deploys the result. Everything not matched below is denied. The pipeline writes with the Admin SDK, which
// bypasses these rules; browsers can only do what is listed here.
service cloud.firestore {
  match /databases/{database}/documents {

    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in __MEMBER_EMAILS__;
    }
    function me() { return request.auth.token.email; }
    function data() { return request.resource.data; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Generated content: read-only.
    match /digests/{date} { allow read: if member(); }
    match /overview/{year} { allow read: if member(); }

    // Each person's reading state; both can see each other's read receipts.
    match /members/{email} {
      allow read: if member();
      allow update: if member() && email == me()
        && data().diff(resource.data).affectedKeys().hasOnly(['reads', 'lastSeen', 'lang']);
    }

    // Where the couple is on the journey (drives what the digest covers).
    match /state/couple {
      allow read: if member();
      allow create, update: if member()
        && data().keys().hasOnly(['stage', 'lmp', 'due', 'birth', 'updatedBy', 'updatedAt'])
        && data().stage in ['ttc', 'pregnant', 'born']
        && data().updatedBy == me()
        && (!('lmp' in data()) || data().lmp == null || isDate(data().lmp))
        && (!('due' in data()) || data().due == null || isDate(data().due))
        && (!('birth' in data()) || data().birth == null || isDate(data().birth));
    }

    // Notes and topic requests for the digest.
    match /inbox/{id} {
      allow read: if member();
      allow create: if member()
        && data().keys().hasOnly(['kind', 'text', 'lang', 'by', 'at', 'status'])
        && data().kind in ['note', 'request']
        && text(data().text, 2000)
        && data().lang in ['en', 'ko']
        && data().by == me()
        && data().status == 'open';
      allow delete: if member() && resource.data.by == me() && resource.data.status == 'open';
    }

    // Per-digest feedback (one vote per person per day).
    match /feedback/{id} {
      allow read: if member();
      allow create, update: if member()
        && id == data().date + '__' + me()
        && data().keys().hasOnly(['date', 'by', 'vote', 'at'])
        && data().by == me()
        && isDate(data().date)
        && (data().vote == null || data().vote in ['helpful', 'deeper', 'known']);
    }

    // Shared "questions for the doctor" list.
    match /questions/{id} {
      allow read: if member();
      allow create: if member()
        && data().keys().hasOnly(['text', 'lang', 'sourceDate', 'by', 'at', 'done'])
        && data().text is map
        && data().lang in ['en', 'ko']
        && text(data().text[data().lang], 600)
        && data().by == me()
        && data().done == false;
      allow update: if member()
        && data().diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'doneBy'])
        && data().done is bool;
      allow delete: if member();
    }
  }
}
