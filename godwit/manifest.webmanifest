{
  "name": "Godwit",
  "short_name": "Godwit",
  "description": "Paul's todo.txt: what's soon, what's later, and what repeats.",
  "id": "/godwit/",
  "start_url": "/godwit/",
  "scope": "/godwit/",
  "display": "standalone",
  "background_color": "#f6f3ee",
  "theme_color": "#f6f3ee",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [{ "name": "Add task", "url": "/godwit/?add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }],
  "share_target": { "action": "/godwit/", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
