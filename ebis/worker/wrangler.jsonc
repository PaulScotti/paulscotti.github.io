{
  // A push to master that changes this Worker deploys it (.githooks/pre-push). The password is the KEY secret, shared
  // with myna, pintail and paisano and checked by worker.js at the top of the repo; the table is in schema.sql.
  // Margin notes need the ANTHROPIC_API_KEY secret (and ANTHROPIC_WORKSPACE, for a key that spans workspaces).
  "name": "ebis",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "account_id": "bf4d563d019ba4efff46afba844e5163",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "ebis", "database_id": "728f1f49-a8c0-4a7e-a95b-5e37c226be74" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ebis-library" }],
  "observability": { "enabled": true }
}
