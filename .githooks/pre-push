#!/bin/sh
# A push to master first deploys each Worker it changes, so a Worker is live before the pages that call it. Each is
# built from the commit being pushed, not the working tree (other sessions' unfinished edits stay out), and deployed
# with this Mac's wrangler login, its version message naming the commit. If a deploy fails, nothing is pushed.
# A Worker changes with its app's worker/ or config.js, or the shared worker.js.
# Turned on once per clone: git config core.hooksPath .githooks
while read -r _ sha ref base; do
  # Only a push GitHub will take: to master, on top of what master has.
  [ "$ref" = refs/heads/master ] && git merge-base --is-ancestor "$base" "$sha" 2>/dev/null || continue
  for app in $(git ls-tree -r --name-only "$sha" | sed -n 's|^\([^/]*\)/worker/wrangler\.jsonc$|\1|p'); do
    git diff --quiet "$base" "$sha" -- "$app/worker" "$app/config.js" worker.js && continue
    dir=$(mktemp -d) msg=$(git log -1 --format='%h %s' "$sha")
    git archive "$sha" worker.js "$app/worker" $(git ls-tree --name-only "$sha" "$app/config.js") | tar -x -C "$dir"
    (cd "$dir/$app/worker" && { [ ! -f package-lock.json ] || npm ci --silent; } && npx wrangler deploy --message "$msg") </dev/null || exit 1
    rm -rf "$dir"
  done
done
