<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The page's own paper behind it, light or dark with the phone, and system bars that read on it. -->
  <style name="Myna" parent="android:Theme.DeviceDefault.DayNight">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/paper</item>
    <item name="android:windowLightStatusBar">@bool/light</item>
    <item name="android:windowLightNavigationBar">@bool/light</item>
  </style>
</resources>
